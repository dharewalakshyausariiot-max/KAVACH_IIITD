# HerGuard Backend Configuration

# Mock mode for demo exposure matches and deepfake detection (true/false)
USE_MOCK=true

# Allowed CORS origins, comma-separated (e.g. http://localhost:3000,http://localhost:5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase configuration for persistent vault storage
SUPABASE_URL=
SUPABASE_KEY=

# TinyFish configuration for real exposure search (when USE_MOCK=false)
TINYFISH_API_KEY=
TINYFISH_URL=
